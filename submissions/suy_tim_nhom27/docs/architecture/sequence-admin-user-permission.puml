@startuml sequence-admin-user-permission
skinparam backgroundColor #FFFFFF
skinparam defaultFontName "Segoe UI"
skinparam defaultFontSize 12
skinparam shadowing false
skinparam roundcorner 6
skinparam class {
  BackgroundColor #FFFFFF
  HeaderBackgroundColor #DBEAFE
  BorderColor #1D4ED8
  FontColor #1E3A8A
  AttributeFontColor #0F172A
  ArrowColor #1D4ED8
}
skinparam entity {
  BackgroundColor #FFFFFF
  HeaderBackgroundColor #DBEAFE
  BorderColor #1D4ED8
  FontColor #1E3A8A
}
skinparam package {
  BackgroundColor #F8FAFC
  BorderColor #93C5FD
  FontColor #1E3A8A
}
skinparam sequence {
  ArrowColor #1D4ED8
  LifeLineBorderColor #64748B
  LifeLineBackgroundColor #DBEAFE
  ParticipantBorderColor #1D4ED8
  ParticipantBackgroundColor #DBEAFE
  ParticipantFontColor #1E3A8A
  ActorBorderColor #1D4ED8
  ActorBackgroundColor #DBEAFE
  ActorFontColor #1E3A8A
  GroupBorderColor #1D4ED8
  GroupHeaderFontColor #1E3A8A
  GroupBackgroundColor #DBEAFE
  BoxBorderColor #93C5FD
  BoxBackgroundColor #F8FAFC
}
skinparam note {
