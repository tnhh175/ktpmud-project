0F172A'&gt;declared_age&lt;/span&gt;: &lt;span style='color:#334155'&gt;smallint&lt;/span&gt;&lt;br/&gt;&lt;span style='color:#94A3B8'&gt;&amp;bull;&lt;/span&gt;&amp;nbsp;&amp;nbsp;&amp;nbsp;&lt;span style='font-weight:600;color:#0F172A'&gt;row_version&lt;/span&gt;: &lt;span style='color:#334155'&gt;integer&lt;/span&gt; &lt;span style='color:#64748B;font-size:10.5px'&gt;NN&lt;/span&gt;&lt;br/&gt;&lt;span style='color:#2563EB;font-weight:700'&gt;FK&lt;/span&gt;&amp;nbsp;&amp;nbsp;&lt;span style='font-weight:600;color:#0F172A'&gt;created_by&lt;/span&gt;: &lt;span style='color:#334155'&gt;uuid&lt;/span&gt; &lt;span style='color:#64748B;font-size:10.5px'&gt;NN&lt;/span&gt;&lt;br/&gt;&lt;span style='color:#94A3B8'&gt;&amp;bull;&lt;/span&gt;&amp;nbsp;&amp;nbsp;&amp;nbsp;&lt;span style='font-weight:600;color:#0F172A'&gt;created_at&lt;/span&gt;: &lt;span style='color:#334155'&gt;timestamptz&lt;/span&gt; &lt;span style='color:#64748B;font-size:10.5px'&gt;NN&lt;/span&gt;&lt;br/&gt;&lt;span style='color:#94A3B8'&gt;&amp;bull;&lt;/span&gt;&amp;nbsp;&amp;nbsp;&amp;nbsp;&lt;span style='font-weight:600;color:#0F172A'&gt;updated_at&lt;/span&gt;: &lt;span style='color:#334155'&gt;timestamptz&lt;/span&gt; &lt;span style='color:#64748B;font-size:10.5px'&gt;NN&lt;/span&gt;&lt;/div&gt;" style="text;html=1;align=left;verticalAlign=top;spacingLeft=10;spacingRight=8;spacingTop=6;whiteSpace=wrap;overflow=hidden;fillColor=#FFFFFF;strokeColor=#1D4ED8;strokeWidth=1;fontFamily=Segoe UI;fontSize=11.5;fontColor=#0F172A;" vertex="1" parent="t_patient">
