        <mxCell id="note_k3k4" value="&lt;div style='font-weight:700;font-size:12.5px;color:#1E3A8A;margin-bottom:4px'&gt;Bất biến Phiên bản &amp;amp; Biểu mẫu Metadata (K3, K4)&lt;/div&gt;&lt;div style='line-height:1.45'&gt;&amp;bull; Mỗi &lt;b&gt;visit&lt;/b&gt; gắn cứng &lt;b&gt;form_version_id&lt;/b&gt; tại thời điểm tạo (lượt cũ luôn giữ bản cũ).&lt;br/&gt;&amp;bull; &lt;b&gt;Trigger DB (K4)&lt;/b&gt;: chặn tuyệt đối UPDATE/DELETE trên &lt;b&gt;form_version&lt;/b&gt; có status='published'/'retired' hoặc đã có lượt khám gắn; chặn sửa &lt;b&gt;form_section&lt;/b&gt;/&lt;b&gt;form_field&lt;/b&gt; của bản đã dùng.&lt;br/&gt;&amp;bull; Muốn sửa biểu mẫu: Admin tạo bản nháp mới (&lt;b&gt;based_on_version_id&lt;/b&gt;), xem trước &amp; diff (tính động, không lưu bảng), rồi phát hành.&lt;br/&gt;&amp;bull; &lt;b&gt;form_field.required_for_confirm&lt;/b&gt; kiểm soát Tầng 3 tách biệt khỏi Tầng 4 (AI readiness).&lt;/div&gt;" style="rounded=1;arcSize=6;whiteSpace=wrap;html=1;fillColor=#EFF6FF;strokeColor=#1D4ED8;strokeWidth=1.4;align=left;verticalAlign=top;spacingLeft=12;spacingRight=12;spacingTop=8;fontFamily=Segoe UI;fontSize=11.5;fontColor=#0F172A;" vertex="1" parent="1">
          <mxGeometry x="820" y="424" width="1510" height="154" as="geometry"/>
        </mxCell>
        <mxCell id="note_enums_quick" value="&lt;div style='font-weight:700;font-size:12.5px;color:#1E3A8A;margin-bottom:4px'&gt;10 Enum Chuẩn (CONTRACT §4.2)&lt;/div&gt;&lt;div style='line-height:1.45'&gt;&amp;bull; &lt;b&gt;user_role&lt;/b&gt;: doctor | admin&lt;br/&gt;&amp;bull; &lt;b&gt;visit_status&lt;/b&gt;: draft | confirmed&lt;br/&gt;&amp;bull; &lt;b&gt;value_state&lt;/b&gt;: answered | unknown&lt;br/&gt;&amp;bull; &lt;b&gt;form_version_status&lt;/b&gt;: draft | published | retired&lt;br/&gt;&amp;bull; &lt;b&gt;field_scope_status&lt;/b&gt;: mvp | can_xac_nhan&lt;br/&gt;&amp;bull; &lt;b&gt;field_data_type&lt;/b&gt;: number | integer | text | boolean | date | single_choice | multi_choice&lt;br/&gt;&amp;bull; &lt;b&gt;section_code&lt;/b&gt;: 8 mã nhóm UX tiếng Việt&lt;br/&gt;&amp;bull; &lt;b&gt;bp_position&lt;/b&gt;: supine | sitting | standing&lt;br/&gt;&amp;bull; &lt;b&gt;readiness_tier&lt;/b&gt; &amp;amp; &lt;b&gt;audit_action&lt;/b&gt; (10 hành động)&lt;/div&gt;" style="rounded=1;arcSize=6;whiteSpace=wrap;html=1;fillColor=#EFF6FF;strokeColor=#1D4ED8;strokeWidth=1.4;align=left;verticalAlign=top;spacingLeft=12;spacingRight=12;spacingTop=8;fontFamily=Segoe UI;fontSize=11.5;fontColor=#0F172A;" vertex="1" parent="1">
          <mxGeometry x="2355" y="138" width="255" height="440" as="geometry"/>
        </mxCell>
