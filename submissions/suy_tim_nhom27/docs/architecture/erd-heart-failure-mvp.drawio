        <mxCell id="t_form_field_body" value="&lt;div style='line-height:1.42'&gt;&lt;span style='color:#1D4ED8;font-weight:700'&gt;PK&lt;/span&gt;&amp;nbsp;&amp;nbsp;&lt;span style='font-weight:600;color:#0F172A'&gt;id&lt;/span&gt;: &lt;span style='color:#334155'&gt;uuid&lt;/span&gt;&lt;br/&gt;&lt;span style='color:#2563EB;font-weight:700'&gt;FK&lt;/span&gt;&amp;nbsp;&amp;nbsp;&lt;span style='font-weight:600;color:#0F172A'&gt;form_version_id&lt;/span&gt;: &lt;span style='color:#334155'&gt;uuid&lt;/span&gt; &lt;span style='color:#64748B;font-size:10.5px'&gt;NN&lt;/span&gt;&lt;br/&gt;&lt;span style='color:#2563EB;font-weight:700'&gt;FK&lt;/span&gt;&amp;nbsp;&amp;nbsp;&lt;span style='font-weight:600;color:#0F172A'&gt;form_section_id&lt;/span&gt;: &lt;span style='color:#334155'&gt;uuid&lt;/span&gt; &lt;span style='color:#64748B;font-size:10.5px'&gt;NN&lt;/span&gt;&lt;br/&gt;&lt;span style='color:#2563EB;font-weight:700'&gt;FK&lt;/span&gt;&amp;nbsp;&amp;nbsp;&lt;span style='font-weight:600;color:#0F172A'&gt;field_definition_id&lt;/span&gt;: &lt;span style='color:#334155'&gt;uuid&lt;/span&gt; &lt;span style='color:#64748B;font-size:10.5px'&gt;NN&lt;/span&gt;&lt;br/&gt;&lt;span style='color:#94A3B8'&gt;&amp;bull;&lt;/span&gt;&amp;nbsp;&amp;nbsp;&amp;nbsp;&lt;span style='font-weight:600;color:#0F172A'&gt;display_order&lt;/span&gt;: &lt;span style='color:#334155'&gt;smallint&lt;/span&gt; &lt;span style='color:#64748B;font-size:10.5px'&gt;NN&lt;/span&gt;&lt;br/&gt;&lt;span style='color:#94A3B8'&gt;&amp;bull;&lt;/span&gt;&amp;nbsp;&amp;nbsp;&amp;nbsp;&lt;span style='font-weight:600;color:#0F172A'&gt;required_for_confirm&lt;/span&gt;: &lt;span style='color:#334155'&gt;boolean&lt;/span&gt; &lt;span style='color:#64748B;font-size:10.5px'&gt;NN&lt;/span&gt;&lt;br/&gt;&lt;span style='color:#94A3B8'&gt;&amp;bull;&lt;/span&gt;&amp;nbsp;&amp;nbsp;&amp;nbsp;&lt;span style='font-weight:600;color:#0F172A'&gt;is_visible&lt;/span&gt;: &lt;span style='color:#334155'&gt;boolean&lt;/span&gt; &lt;span style='color:#64748B;font-size:10.5px'&gt;NN&lt;/span&gt;&lt;br/&gt;&lt;span style='color:#94A3B8'&gt;&amp;bull;&lt;/span&gt;&amp;nbsp;&amp;nbsp;&amp;nbsp;&lt;span style='font-weight:600;color:#0F172A'&gt;is_readonly&lt;/span&gt;: &lt;span style='color:#334155'&gt;boolean&lt;/span&gt; &lt;span style='color:#64748B;font-size:10.5px'&gt;NN&lt;/span&gt;&lt;br/&gt;&lt;span style='color:#94A3B8'&gt;&amp;bull;&lt;/span&gt;&amp;nbsp;&amp;nbsp;&amp;nbsp;&lt;span style='font-weight:600;color:#0F172A'&gt;custom_label_vi&lt;/span&gt;: &lt;span style='color:#334155'&gt;varchar(200)&lt;/span&gt;&lt;br/&gt;&lt;span style='color:#94A3B8'&gt;&amp;bull;&lt;/span&gt;&amp;nbsp;&amp;nbsp;&amp;nbsp;&lt;span style='font-weight:600;color:#0F172A'&gt;custom_help_text&lt;/span&gt;: &lt;span style='color:#334155'&gt;text&lt;/span&gt;&lt;/div&gt;" style="text;html=1;align=left;verticalAlign=top;spacingLeft=10;spacingRight=8;spacingTop=6;whiteSpace=wrap;overflow=hidden;fillColor=#FFFFFF;strokeColor=#1D4ED8;strokeWidth=1;fontFamily=Segoe UI;fontSize=11.5;fontColor=#0F172A;" vertex="1" parent="t_form_field">
